# Copy this file to `deploy/.env` and replace the placeholder with a real secret.
# `.env` is gitignored; `.env.example` is committed.
#
# Generate a fresh key with:   openssl rand -hex 32
#
# Both the local Fastify server (`npm run server`) and docker-compose
# (`cd deploy && docker compose up`) pick this file up automatically.

QUALITY_API_KEY=<64-hex-string>
