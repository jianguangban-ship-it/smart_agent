{
  "name": "jira-ai-task-workstation",
  "version": "8.48.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "server": "tsx watch --env-file-if-exists=deploy/.env server/index.ts",
    "dev:all": "concurrently -k -r -n vite,server -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=deploy/.env --import tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.7",
    "@vueuse/core": "^14.2.1",
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.3.1",
    "echarts": "^6.1.0",
    "fastify": "^4.28.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.33",
    "markdown-it": "^14.1.1",
    "markdown-it-texmath": "^1.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.19.2",
    "unified": "^11.0.5",
    "vue": "^3.5.13",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.8"
  }
}
